{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rongmetro:dataset:1.0",
  "title": "Metro indoor routing dataset v1.0",
  "type": "object",
  "required": ["schemaVersion", "version", "city", "description", "provenance", "stations", "lines", "formations", "platforms", "services", "walkNodes", "walkEdges"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "version": { "$ref": "#/$defs/text" },
    "description": { "$ref": "#/$defs/text" },
    "city": { "type": "object", "required": ["id", "name"], "properties": { "id": { "$ref": "#/$defs/text" }, "name": { "$ref": "#/$defs/text" } } },
    "provenance": { "$ref": "#/$defs/provenance" },
    "stations": { "type": "array", "items": { "$ref": "#/$defs/station" } },
    "lines": { "type": "array", "items": { "$ref": "#/$defs/line" } },
    "formations": { "type": "array", "items": { "$ref": "#/$defs/formation" } },
    "platforms": { "type": "array", "items": { "$ref": "#/$defs/platform" } },
    "services": { "type": "array", "items": { "$ref": "#/$defs/service" } },
    "walkNodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "walkEdges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "externalTransfers": { "type": "array", "items": { "$ref": "#/$defs/externalTransfer" } },
    "manualRecommendations": { "type": "array", "items": { "$ref": "#/$defs/manualRecommendation" } },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "nonnegative": { "type": "number", "minimum": 0 },
    "knowledge": { "enum": ["confirmed", "unknown"] },
    "provenance": {
      "type": "object", "required": ["kind", "source", "recordedAt"],
      "properties": { "kind": { "enum": ["demo", "survey", "official", "user"] }, "source": { "$ref": "#/$defs/text" }, "recordedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } }
    },
    "station": {
      "type": "object", "required": ["id", "name", "concourseNodeIds", "indoorData"],
      "properties": { "id": { "$ref": "#/$defs/text" }, "name": { "$ref": "#/$defs/text" }, "concourseNodeIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }, "indoorData": { "enum": ["complete", "partial", "missing"] } }
    },
    "line": {
      "type": "object", "required": ["id", "name", "color"],
      "properties": { "id": { "$ref": "#/$defs/text" }, "name": { "$ref": "#/$defs/text" }, "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } }
    },
    "position": {
      "type": "object", "required": ["id", "car", "door", "longitudinalMetres"],
      "properties": { "id": { "$ref": "#/$defs/text" }, "car": { "type": "integer", "minimum": 1 }, "door": { "type": "integer", "minimum": 1 }, "longitudinalMetres": { "anyOf": [{ "$ref": "#/$defs/nonnegative" }, { "type": "null" }] }, "numberingConfirmed": { "type": "boolean" } }
    },
    "formation": {
      "type": "object", "required": ["id", "cars", "positions"],
      "properties": { "id": { "$ref": "#/$defs/text" }, "cars": { "type": "integer", "minimum": 1 }, "positions": { "type": "array", "items": { "$ref": "#/$defs/position" } }, "doorsKnown": { "type": "boolean" }, "numberingStatus": { "enum": ["unknown", "confirmed"] } }
    },
    "platform": {
      "type": "object", "required": ["id", "stationId", "lineId", "level", "doorNodes"],
      "properties": { "id": { "$ref": "#/$defs/text" }, "stationId": { "$ref": "#/$defs/text" }, "lineId": { "$ref": "#/$defs/text" }, "level": { "type": "number" }, "doorNodes": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/text" } } }
    },
    "stop": {
      "type": "object", "required": ["stationId"],
      "properties": { "stationId": { "$ref": "#/$defs/text" }, "platformId": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] }, "minutesFromPrevious": { "anyOf": [{ "$ref": "#/$defs/nonnegative" }, { "type": "null" }] } }
    },
    "service": {
      "type": "object", "required": ["id", "lineId", "direction", "formationId", "stops"],
      "properties": { "id": { "$ref": "#/$defs/text" }, "lineId": { "$ref": "#/$defs/text" }, "direction": { "$ref": "#/$defs/text" }, "formationId": { "$ref": "#/$defs/text" }, "stops": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/stop" } } }
    },
    "node": {
      "type": "object", "required": ["id", "stationId", "level", "label", "kind", "knowledge"],
      "properties": { "id": { "$ref": "#/$defs/text" }, "stationId": { "$ref": "#/$defs/text" }, "level": { "type": "number" }, "label": { "$ref": "#/$defs/text" }, "kind": { "enum": ["concourse", "facility", "door", "corridor"] }, "knowledge": { "$ref": "#/$defs/knowledge" } }
    },
    "externalTransfer": {
      "type": "object", "required": ["id", "fromStationId", "toStationId", "bidirectional", "walkingMetres", "minutes", "wheelchair", "provenance"],
      "properties": { "id": { "$ref": "#/$defs/text" }, "fromStationId": { "$ref": "#/$defs/text" }, "toStationId": { "$ref": "#/$defs/text" }, "bidirectional": { "type": "boolean" }, "walkingMetres": { "anyOf": [{ "$ref": "#/$defs/nonnegative" }, { "type": "null" }] }, "minutes": { "anyOf": [{ "$ref": "#/$defs/nonnegative" }, { "type": "null" }] }, "wheelchair": { "enum": ["confirmed", "unknown", "blocked"] }, "provenance": { "$ref": "#/$defs/provenance" } }
    },
    "manualRecommendation": {
      "type": "object", "required": ["id", "stationId", "serviceId", "purpose", "positions", "note", "provenance"],
      "properties": { "id": { "$ref": "#/$defs/text" }, "stationId": { "$ref": "#/$defs/text" }, "serviceId": { "$ref": "#/$defs/text" }, "purpose": { "enum": ["transfer", "exit"] }, "targetServiceId": { "$ref": "#/$defs/text" }, "positions": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["car", "door"], "properties": { "car": { "type": "integer", "minimum": 1 }, "door": { "type": "integer", "minimum": 1 } } } }, "note": { "type": "string" }, "provenance": { "$ref": "#/$defs/provenance" } }
    },
    "edge": {
      "type": "object", "required": ["id", "from", "to", "kind", "metres", "seconds", "stairCount", "knowledge", "wheelchair", "bidirectional", "provenance"],
      "properties": { "id": { "$ref": "#/$defs/text" }, "from": { "$ref": "#/$defs/text" }, "to": { "$ref": "#/$defs/text" }, "kind": { "enum": ["walk", "stairs", "escalator", "lift"] }, "metres": { "$ref": "#/$defs/nonnegative" }, "seconds": { "type": "number", "exclusiveMinimum": 0 }, "stairCount": { "type": "integer", "minimum": 0 }, "knowledge": { "$ref": "#/$defs/knowledge" }, "wheelchair": { "enum": ["confirmed", "blocked", "unknown"] }, "bidirectional": { "type": "boolean" }, "provenance": { "$ref": "#/$defs/provenance" } }
    }
  }
}
